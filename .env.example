# ============================
# MedAssist AI Configuration
# ============================

# Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Project Directories
DOCUMENTS_DIR=documents
VECTOR_STORE_DIR=vector_store
UPLOADS_DIR=uploads
LOGS_DIR=logs

# Embedding Model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Gemini Model
LLM_MODEL=gemini-2.5-flash

# Retrieval Settings
TOP_K=5
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Application
APP_NAME=MedAssist AI
APP_VERSION=1.0.0
DEBUG=False